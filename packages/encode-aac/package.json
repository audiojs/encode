{
  "name": "@audio/encode-aac",
  "version": "1.2.0",
  "description": "Encode PCM audio samples to AAC (ADTS): WebCodecs, else the Fraunhofer FDK encoder (WASM)",
  "type": "module",
  "main": "aac-encode.js",
  "types": "aac-encode.d.ts",
  "exports": {
    ".": "./aac-encode.js",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "aac-encode.js",
    "aac-encode.d.ts",
    "src/fdk.wasm.js",
    "LICENSE",
    "LICENSE.fdk-aac",
    "audio.js",
    "audio.d.ts"
  ],
  "keywords": [
    "aac",
    "m4a",
    "adts",
    "audio",
    "encode",
    "encoder",
    "codec",
    "webcodecs",
    "fdk-aac",
    "he-aac",
    "wasm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT AND FDK-AAC",
  "author": "audiojs",
  "homepage": "https://github.com/audiojs/encode/tree/main/packages/encode-aac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/encode.git",
    "directory": "packages/encode-aac"
  },
  "engines": {
    "node": ">=18"
  },
  "bugs": "https://github.com/audiojs/encode/issues",
  "scripts": {
    "test": "node test.js",
    "build": "bash build.sh",
    "prepack": "npm run build"
  },
  "audio": "./audio.js",
  "sideEffects": false,
  "funding": "https://github.com/sponsors/audiojs"
}
